PORT=4981

# Cookie pool — add as many pairs as you want (comma-separated)
GEMINI_COOKIES_FILE=path/to/your/file.txt

# Required: Get these from your browser cookies at gemini.google.com
GEMINI_1PSID=g.blablabla
GEMINI_1PSIDTS=sidts-blablabla

# Optional tuning
GEMINI_REFRESH_INTERVAL=30
GEMINI_MAX_RETRIES=3

# Rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10